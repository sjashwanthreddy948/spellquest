# SpellQuest Environment Configuration
# Copy this file to .env.local to configure Supabase Cloud Database

# 1. Supabase Project URL (From Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon Key (From Project Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
