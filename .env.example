# ========================================================================
# SpellQuest AI - Environment Variables Template
# ========================================================================

# Optional: Google Gemini API Key for dynamic AI Coach tricks & hints
# If omitted, the application uses its built-in deterministic pedagogical heuristic engine.
GEMINI_API_KEY=

# Optional: Supabase / PostgreSQL Database Connection (for cloud sync)
# Defaults to offline-first local persistence if omitted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
